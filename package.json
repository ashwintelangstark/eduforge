{
  "name": "eduforge",
  "version": "1.0.0",
  "private": true,
  "description": "EduForge - Desktop Document Editor & Question Paper Authoring Suite by HAEGL Technologies",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"server,web\" -c \"magenta,green\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/server && npm run build --workspace=apps/web && node -e \"const fs=require('fs'); fs.cpSync('apps/web/dist', 'dist', {recursive: true});\"",
    "build:cpanel": "node scripts/build-cpanel-change-zips.js",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migration:new": "supabase migration new"
  },
  "keywords": [
    "question-paper-builder",
    "math-ast",
    "scientific-editor",
    "docx",
    "pdf",
    "a4-canvas"
  ],
  "author": "HAEGL Technologies",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
